# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Xano ---
# Base URL of your Xano workspace instance API, e.g. https://xxxx.n8n.xano.io/api:xxxx
XANO_API_BASE_URL=
XANO_API_KEY=

# --- Foxit ---
# eSign API — use the eSign API credentials (client_id/client_secret), NOT
# the general Document Generation API or PDF Embed API (those are separate
# Foxit products we deliberately don't use — Doctavian is our document
# engine, Foxit is only for signing).
FOXIT_ESIGN_API_KEY=
FOXIT_ESIGN_API_SECRET=
FOXIT_ESIGN_API_BASE_URL=https://na1.fusion.foxit.com/esign/api

# --- Doctavian ---
# Credentials obtained by emailing hello@doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_API_BASE_URL=https://demo.api.doctavian.com

# --- LLM (for the two-pass NLU front-door, Phase 4) ---
LLM_API_KEY=
LLM_MODEL=

# --- General ---
# Accelerated TTL for demo purposes (seconds). Leave unset to use real durations.
DEMO_TTL_ACCELERATION_SECONDS=
