# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Xano ---
# Base URL of your Xano workspace instance API, e.g. https://xxxx.n8n.xano.io/api:xxxx
XANO_API_BASE_URL=
XANO_API_KEY=

# --- Foxit ---
# eSign API — use the eSign API credentials (client_id/client_secret), NOT
# the general Document Generation API or PDF Embed API (those are separate
# Foxit products we deliberately don't use — Doctavian is our document
# engine, Foxit is only for signing).
FOXIT_ESIGN_API_KEY=
FOXIT_ESIGN_API_SECRET=
FOXIT_ESIGN_API_BASE_URL=https://na1.fusion.foxit.com/esign/api

# --- Doctavian ---
# Credentials obtained by emailing hello@doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_API_BASE_URL=https://demo.api.doctavian.com
# OAuth bearer token, obtained manually via Postman's "Get New Access Token"
# button (their OAuth client's redirect_uri is locked to oauth.pstmn.io, so
# this cannot be automated without Postman). SHORT-LIVED — re-generate via
# Postman and paste the new value here whenever it expires (their docs:
# rejected within ~2 min of expiry). Do not commit a real token value.
DOCTAVIAN_ACCESS_TOKEN=

# --- LLM (for the two-pass NLU front-door, Phase 4) ---
# Fallback chain: 2 Gemini models -> 2 Groq models -> 2 OpenRouter models.
# Any provider left blank is skipped entirely (its 2 models just don't
# get added to the chain) -- you don't need all three to test locally,
# but the demo is more resilient (won't fail on one provider's rate
# limit) with all three configured.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: Anthropic is also supported as a standalone client
# (llm_client.AnthropicLLMClient) but not part of the default fallback
# chain above -- add manually if you want it included.
ANTHROPIC_API_KEY=

# --- General ---
# Accelerated TTL for demo purposes (seconds). Leave unset to use real durations.
DEMO_TTL_ACCELERATION_SECONDS=
