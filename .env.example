# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Xano ---
# Base URL of your Xano workspace instance API, e.g. https://xxxx.n8n.xano.io/api:xxxx
XANO_API_BASE_URL=
XANO_API_KEY=

# --- Foxit ---
# PDF manipulation via the open-source MCP server does not require a key.
# The eSign API is separate and requires credentials from theodore_castro@foxitsoftware.com
FOXIT_ESIGN_API_KEY=
FOXIT_ESIGN_API_BASE_URL=

# --- Doctavian ---
# Credentials obtained by emailing hello@doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_API_BASE_URL=

# --- LLM (for the two-pass NLU front-door, Phase 4) ---
LLM_API_KEY=
LLM_MODEL=

# --- General ---
# Accelerated TTL for demo purposes (seconds). Leave unset to use real durations.
DEMO_TTL_ACCELERATION_SECONDS=
