# Copy to .env.local (already gitignored via root .gitignore's .env.local rule).
#
# NEXT_PUBLIC_API_MODE=mock (default if unset)
#   Talks to this app's own /api/mock/* route handlers, which are a
#   deterministic, in-memory port of the exact same reference algorithms
#   as apps/agent/src/tegata_agent/ (risk_engine.py, approval_rules.py,
#   state_machine.py, audit_log.py, warrant_verification.py — see
#   lib/referenceLogic.ts). No network dependency, no credentials
#   needed. This is what tests/e2e/playwright.config.ts runs against.
#
# NEXT_PUBLIC_API_MODE=xano
#   Talks to a real Xano workspace. Create is POST /score, sign/activate
#   is POST /warrants/transition — both confirmed against the live
#   workspace (see docs/xano-setup.md §9a/§9b). This is what
#   tests/e2e/playwright.xano.config.ts runs against.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_XANO_API_BASE_URL=

# Only needed when NEXT_PUBLIC_API_MODE=xano — Tegata Core is a Private
# API group, so every request needs a bearer token from a logged-in
# user. This comes from a SEPARATE Xano API group ("Authentication"),
# which has its own base URL (find it under Xano's "Connect this
# backend" -> "API URLs", NOT the Swagger Docs panel — Swagger is
# documentation, not a URL your code calls).
#
# Confirmed against the real workspace: POST /auth/signup
# {name, email, password, role?} and POST /auth/login {email, password}
# both return {authToken}. `role` is optional and restricted to exactly
# "requester" or "approver" (see docs/xano-setup.md §9d) — anything
# else, including "security_admin", is ignored and falls back to the
# default ("requester"). The app's own login/register FORM never sends
# this field, so a real user still can't self-assign a role; only
# tests/e2e/xano/full-flow.spec.ts uses it, calling the endpoint
# directly to create a throwaway approver account per test run.
NEXT_PUBLIC_XANO_AUTH_BASE_URL=
NEXT_PUBLIC_XANO_AUTH_SIGNUP_PATH=/auth/signup
NEXT_PUBLIC_XANO_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_XANO_AUTH_ME_PATH=/auth/me

# --- Real signing pipeline (app/api/documents/prepare, added 2026-08-29) ---
# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Same values as the root .env's DOCTAVIAN_*/FOXIT_ESIGN_* vars (that
# root .env is for apps/agent's Python reference client; this app has
# its own TS port in lib/doctavianClient.ts + lib/foxitClient.ts and
# needs the values here too since Next.js only loads apps/web/.env.local).
DOCTAVIAN_API_KEY=
DOCTAVIAN_API_BASE_URL=https://demo.api.doctavian.com
DOCTAVIAN_ACCESS_TOKEN=
FOXIT_ESIGN_API_KEY=
FOXIT_ESIGN_API_SECRET=
FOXIT_ESIGN_API_BASE_URL=https://na1.fusion.foxit.com/esign/api
