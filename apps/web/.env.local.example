# Copy to .env.local (already gitignored via root .gitignore's .env.local rule).
#
# NEXT_PUBLIC_API_MODE=mock (default if unset)
#   Talks to this app's own /api/mock/* route handlers, which are a
#   deterministic, in-memory port of the exact same reference algorithms
#   as apps/agent/src/tegata_agent/ (risk_engine.py, approval_rules.py,
#   state_machine.py, audit_log.py, warrant_verification.py — see
#   lib/referenceLogic.ts). No network dependency, no Xano credentials
#   needed. This is what tests/e2e's Playwright tests run against, and
#   what "npm run dev" uses if you haven't set up real Xano yet.
#
# NEXT_PUBLIC_API_MODE=xano
#   Talks to a real Xano workspace at NEXT_PUBLIC_XANO_API_BASE_URL.
#   As of 2026-08-28 this requires the two endpoints specced in
#   docs/xano-setup.md §9a (POST /verify-signature) and §9b
#   (POST /warrants) to actually exist in your Xano workspace — neither
#   is built yet (see PROJECT_STATUS.md). The other three endpoints
#   (POST /score, POST /derive-approval-requirement, GET /warrants,
#   GET /audit-log) are already built per PROJECT_STATUS.md's "Xano
#   setup, first pass" section, though some had discrepancies found
#   during verification (see docs/xano-verification-worksheet.md) —
#   confirm those are fixed before trusting xano mode's output.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_XANO_API_BASE_URL=

# Only needed when NEXT_PUBLIC_API_MODE=xano — Tegata Core is a Private
# API group, so every request needs a bearer token from a logged-in
# user. This comes from a SEPARATE Xano API group ("Authentication"),
# which has its own base URL (find it under Xano's "Connect this
# backend" -> "API URLs", NOT the Swagger Docs panel — Swagger is
# documentation, not a URL your code calls).
#
# Confirmed 2026-08-28 against the real workspace via Xano's Run &
# Debug panel: POST /auth/signup {name, email, password} and
# POST /auth/login {email, password} both return {authToken}; new
# users default to role="requester" — there is no way to choose a role
# at signup, an "approver" account must be set manually by editing the
# user row in Xano's Database tab.
NEXT_PUBLIC_XANO_AUTH_BASE_URL=
NEXT_PUBLIC_XANO_AUTH_SIGNUP_PATH=/auth/signup
NEXT_PUBLIC_XANO_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_XANO_AUTH_ME_PATH=/auth/me
